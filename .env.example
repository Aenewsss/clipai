# ClipAI - Environment Variables
# Copy this to .env.local and fill in your keys

# ─── LLM Provider ────────────────────────────────────────────
# Which provider to use for clip analysis: "anthropic" (default) or "deepseek"
LLM_PROVIDER=deepseek

# Anthropic API Key (required when LLM_PROVIDER=anthropic)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the default model
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek API Key (required when LLM_PROVIDER=deepseek)
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional: override the default model
# DEEPSEEK_MODEL=deepseek-chat

# ─── Storage Provider ────────────────────────────────────────
# Which provider to use for clip storage: "supabase" (default) or "local"
STORAGE_PROVIDER=supabase

# Supabase credentials (required when STORAGE_PROVIDER=supabase)
# Get at: https://supabase.com/dashboard → Settings → API
# Obs: create a public bucket named "clips" in Storage before using
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Transcription Provider ──────────────────────────────────
# Which provider to use for audio transcription: "groq" (default)
TRANSCRIPTION_PROVIDER=groq

# Groq API Key (required when TRANSCRIPTION_PROVIDER=groq)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Auth (NextAuth) ─────────────────────────────────────────
# Get NEXTAUTH_SECRET: run `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─── Token Encryption ────────────────────────────────────────
# 32-byte key in hex (64 chars). Generate: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# ─── Google OAuth (Login + YouTube publishing) ────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: YouTube Data API v3
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
#               {NEXTAUTH_URL}/api/social/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Meta / Facebook OAuth (Instagram publishing) ─────────────
# Create at: https://developers.facebook.com → My Apps → Create App
# Required permissions: instagram_content_publish, instagram_basic, pages_read_engagement, pages_show_list
# Redirect URI: {NEXTAUTH_URL}/api/social/callback/instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── TikTok OAuth (TikTok publishing) ────────────────────────
# Register at: https://developers.tiktok.com → Manage Apps
# Required scope: user.info.basic, video.publish
# Redirect URI: {NEXTAUTH_URL}/api/social/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Stripe (Pagamentos) ─────────────────────────────────────
# Crie em: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# ID do preço do plano Pro (crie em Products no dashboard Stripe)
STRIPE_PRO_PRICE_ID=
# Webhook secret: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Chave pública (usada no frontend se necessário)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
